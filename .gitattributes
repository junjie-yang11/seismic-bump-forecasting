# Normalise line endings so that the repository behaves identically on
# Windows, macOS and Linux. Without this, Git warns on every operation and
# Windows checkouts silently convert LF to CRLF, which shows up as spurious
# "modified" files when the repository is cloned elsewhere.
* text=auto eol=lf

# Windows-native scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artefacts must never be line-ending converted
*.png  binary
*.pdf  binary
*.docx binary

# Curated text formats
*.md   text eol=lf
*.py   text eol=lf
*.csv  text eol=lf
*.json text eol=lf

# These paths participate in SHA-256 provenance checks. Preserve their exact
# recorded bytes on every platform, including the locked protocol and reports.
# Git line-ending conversion would otherwise invalidate a clean checkout.
src/**     -text whitespace=trailing-space,space-before-tab,cr-at-eol
phase1/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
phase2/**  -text whitespace=trailing-space,space-before-tab,cr-at-eol
results/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
reports/**  -text whitespace=trailing-space,space-before-tab,cr-at-eol
docs/audits/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
